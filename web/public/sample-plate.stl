    outer loop
      vertex -10 -10 -1
      vertex -10 10 -1
      vertex 10 10 -1
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -10 -10 1
      vertex 10 -10 1
      vertex 10 10 1
    endloop
  endfacet
  facet normal 0 0 1
    outer loop
      vertex -10 -10 1
      vertex 10 10 1
      vertex -10 10 1
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -10 -10 -1
      vertex 10 -10 -1
      vertex 10 -10 1
    endloop
  endfacet
  facet normal 0 -1 0
    outer loop
      vertex -10 -10 -1
      vertex 10 -10 1
      vertex -10 -10 1
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 10 -10 -1
      vertex 10 10 -1
      vertex 10 10 1
    endloop
  endfacet
  facet normal 1 0 0
    outer loop
      vertex 10 -10 -1
      vertex 10 10 1
      vertex 10 -10 1
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 10 10 -1
      vertex -10 10 -1
      vertex -10 10 1
    endloop
  endfacet
  facet normal 0 1 0
    outer loop
      vertex 10 10 -1
      vertex -10 10 1
      vertex 10 10 1
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -10 10 -1
      vertex -10 -10 -1
      vertex -10 -10 1
    endloop
  endfacet
  facet normal -1 0 0
    outer loop
      vertex -10 10 -1
      vertex -10 -10 1
      vertex -10 10 1
    endloop
  endfacet
endsolid sample_plate
